);
let windowsS = merge(translate(winS, (-160, 0, 450)), translate(winS, (160, 0, 450)), translate(winS, (0, 0, 160)));
let quoins = array(box_at(size: (30, 30, 42), bottom_center: (-400, -450, 40), bevel: 4, material: "StoneDark"), count: 2, offset: (0, 0, 46));
let roof = gable_roof(size: (880, 980, 22), bottom_center: (0, 0, 640), roof_height: 320, overhang: 30, ridge_axis: "x", material: "RoofSlate");
let chimney = box_at(size: (60, 60, 220), bottom_center: (150, 250, 800), bevel: 3, material: "StoneDark");
out.geo = merge(plinth, stone, upper, fposts, fbeams, sposts, sbeams, braces, doorFrame, door, lintel, windowsF, windowsS, quoins, roof, chimney);
#end

#mesh FlowerWhite
let stem = cylinder_between(start: (0, 0, 0), end: (0, 0, 34), radius: 0.6, segments: 5, material: "StemGreen");
let petal = scale(sphere_center(radius: 3, segments: 6, center: (3.5, 0, 34), material: "PetalWhite"), (1, 0.6, 0.35), pivot: (3.5, 0, 34));
let petals = merge(petal, rotate_z(petal, 72), rotate_z(petal, 144), rotate_z(petal, 216), rotate_z(petal, 288));
let heart = sphere_center(radius: 1.8, segments: 6, center: (0, 0, 35), material: "PetalYellow");
out.geo = merge(stem, petals, heart);
#end

#mesh FlowerYellow
let stem = cylinder_between(start: (0, 0, 0), end: (0, 0, 30), radius: 0.6, segments: 5, material: "StemGreen");
let petal = scale(sphere_center(radius: 2.6, segments: 6, center: (3, 0, 30), material: "PetalYellow"), (1, 0.6, 0.35), pivot: (3, 0, 30));
let petals = merge(petal, rotate_z(petal, 72), rotate_z(petal, 144), rotate_z(petal, 216), rotate_z(petal, 288));
let heart = sphere_center(radius: 1.5, segments: 6, center: (0, 0, 31), material: "PetalHeart");
out.geo = merge(stem, petals, heart);
#end

#scatter WhiteFlowers
  model: "mesh.FlowerWhite"
  spacing: 110
  density_pct: 45
  scale_min_pct: 70
  scale_max_pct: 130
  seed: 4
  terrain_normal_align_pct: 0
#end

#scatter YellowFlowers
