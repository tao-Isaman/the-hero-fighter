// RO-style cast bar over the caster's head
#texture CastBarBack color=#18212c roughness=0.9
#texture CastBarGreen color=#5bdc4a roughness=0.6 emission=3
#mesh CastBarFrameMesh
out.geo = box_at(size: (2, 70, 11), bottom_center: (0, 0, 0), material: "CastBarBack");
#end
#mesh CastBarFillMesh
out.geo = box_at(size: (2, 100, 6), bottom_center: (0, 0, 0), material: "CastBarGreen");
#end
display CastBarFrame { model = "mesh.CastBarFrameMesh" position = (970, 250, -1000) }
display CastBarFill { model = "mesh.CastBarFillMesh" position = (968, 282, -1000) size = (2, 1, 6) }

// Spell timeline (60 fps), matched to the reel:
//   cast   : rune circle + cast bar fill for 1.5 s, caster lifts slightly
//   release: white flash + ripple rings, flower carpet blooms outward and breathes
//   end    : carpet dissolves centre-out into rising petals that fade
// Repeats every CycleFrames; F recasts.
#class FlowerSpell
var T = 0
var Base: Position
var Fx: List<Object>
var CastAt = 90
const CastFrames = 90
const HoldFrames = 330
const CycleFrames = 900
const BarZ = 145
event OnSpawned {
    Base = GetPosition()
    forever {
        T = T + 1
        var lift = 0
        if T > CastAt and T < CastAt + CastFrames + HoldFrames {
            var ramp = (T - CastAt) / 40
            if ramp > 1 { ramp = 1 }
            var fall = (CastAt + CastFrames + HoldFrames - T) / 40
            if fall < ramp { ramp = fall }
            lift = ramp * (10 + 4 * (T * 4).SinDegree())
        }
        if Scene.Mage.Exists() { Scene.Mage.SetPosition(Position(Base.X, Base.Y, Base.Z + lift)) }
        if T == CastAt {
            Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.CastCircle, Position(Base.X, Base.Y, Base.Z + 150)))
        }
        if T >= CastAt and T < CastAt + CastFrames {
            var w = 64 * (T - CastAt + 1) / CastFrames
            Scene.CastBarFrame.SetPosition(Position(Base.X - 30, Base.Y, Base.Z + lift + BarZ))
            Scene.CastBarFill.SetSize(2, w, 6)
            Scene.CastBarFill.SetPosition(Position(Base.X - 32, Base.Y + 32 - w / 2, Base.Z + lift + BarZ + 2))
        }
        if T == CastAt + CastFrames {
            Scene.CastBarFrame.SetPosition(Position(Base.X, Base.Y, Base.Z - 1000))
            Scene.CastBarFill.SetPosition(Position(Base.X, Base.Y, Base.Z - 1000))
            Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.CastRelease, Position(Base.X, Base.Y, Base.Z + 150)))
            Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.FlowerCarpet, Position(Base.X, Base.Y, Base.Z + 50)))
        }
        var since = T - CastAt - CastFrames
        if since == 270 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.DissolveSparkle, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 270 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand0, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 282 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand1, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 294 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand2, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 306 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand3, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 318 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand4, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 330 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand5, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 342 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand6, Position(Base.X, Base.Y, Base.Z + 200))) }
        if since == 354 { Fx.Add(SpawnEffectWithAutoDestroy(Ori.effect.PetalBand7, Position(Base.X, Base.Y, Base.Z + 200))) }
        if T >= CycleFrames {
            T = 0
            Fx.Clear()
        }
    }
}
// F: clean recast at any time (clears effects still on screen)
event KeyboardDown[F] {
    while Fx.Count() > 0 {
        var e = Fx.Pop()
        if e.Exists() { e.DestroyImmediate() }
    }
    T = CastAt - 1
}
#end
display SpellCenter : FlowerSpell { visible = false position = (1000, 250, 0) }

// ---------- step 2: the caster (Oriverse-generated sprite from the supplied character sheet) ----------
#sprite ElfMage
source="Ori.sprite.@taoisaman.elf_mage#1"
#end
display Mage { sprite = "ElfMage" size = (1, 110, 110) position = (1000, 250, 0) rotation = (0, 0, 180) }
