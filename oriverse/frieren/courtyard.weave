}
let r = length(uv - c) / plen;
let streak = noise.fbm(vec2(atan2(uv.y - 0.5, uv.x - 0.5) * 9.0, r * 2.0), octaves: 2, seed: 4);
let petal_col = mix(base_col, edge_col, sat(0.65 - r * 0.6 + 0.4 * streak)) * (0.93 + 0.1 * pid);
let core = fill(sdf.circle(uv, c, crad + 0.012 * noise.fbm(uv * 30.0, octaves: 2, seed: 9)));
let dots = noise.fbm(uv * 60.0, octaves: 1, seed: 2);
let core_shade = mix(core_col * 0.8, core_col * 1.05, sat(1.0 - length(uv - c - vec2(-0.03, -0.03)) / crad + 0.25 * dots));
out.color = mix(petal_col, core_shade, core);
out.alpha = max(cov, core);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

#texture PetalCard
mapping = uv;
wrap = clamp;
render_mode = cutout_twosided;
size = 128;
let d = sdf.segment(uv, vec2(0.5, 0.2), vec2(0.5, 0.72)) - 0.2 * (0.55 + 0.45 * sat((uv.y - 0.15) / 0.6));
let streak = noise.fbm(vec2(uv.x * 14.0, uv.y * 2.0), octaves: 2, seed: 6);
out.color = mix(color("#ffffff"), color("#e9eef6"), sat(0.3 + 0.5 * streak - 0.4 * uv.y));
out.alpha = fill(d);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

#texture GlowDot
mapping = uv;
wrap = clamp;
size = 64;
let d = length(uv - vec2(0.5, 0.5));
out.color = vec3(1.0, 1.0, 1.0) * smoothstep(0.5, 0.0, d);
out.alpha = smoothstep(0.5, 0.05, d);
#end

#texture MagicCircle
mapping = uv;
wrap = clamp;
size = 512;
let c = vec2(0.5, 0.5);
let p = uv - c;
let r = length(p);
let ang = atan2(p.y, p.x) / 6.2832 + 0.5;
let rings = max(max(stroke(sdf.circle(uv, c, 0.47), 0.014), stroke(sdf.circle(uv, c, 0.405), 0.008)), max(stroke(sdf.circle(uv, c, 0.25), 0.007), stroke(sdf.circle(uv, c, 0.12), 0.006)));
let cell = floor(ang * 40.0);
let runes = step(0.25, fract(ang * 40.0)) * step(fract(ang * 40.0), 0.75) * step(0.415, r) * step(r, 0.455) * step(0.35, rand(cell * 3.0 + 1.0));
let t0 = max(max(stroke(sdf.segment(uv, c + vec2(0.0, 0.40), c + vec2(0.3464, -0.2)), 0.007), stroke(sdf.segment(uv, c + vec2(0.3464, -0.2), c + vec2(-0.3464, -0.2)), 0.007)), stroke(sdf.segment(uv, c + vec2(-0.3464, -0.2), c + vec2(0.0, 0.40)), 0.007));
let t1 = max(max(stroke(sdf.segment(uv, c + vec2(0.0, -0.40), c + vec2(0.3464, 0.2)), 0.007), stroke(sdf.segment(uv, c + vec2(0.3464, 0.2), c + vec2(-0.3464, 0.2)), 0.007)), stroke(sdf.segment(uv, c + vec2(-0.3464, 0.2), c + vec2(0.0, -0.40)), 0.007));
let glow = smoothstep(0.5, 0.0, abs(r - 0.44)) * 0.25 * step(r, 0.5);
let m = sat(max(max(rings, runes), max(t0, t1)) + glow);
out.color = vec3(0.55, 1.0, 0.6) * m;
out.alpha = m;
#end

