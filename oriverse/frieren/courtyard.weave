// ---------- step 3: flower spell (matched to the reference reel) ----------
// Nine flowers from the daisy sketch (reference image 3), recoloured to the reel's blue/violet/yellow carpet.
// 3x3 atlas: particles pick a random cell (flipbookStartRandom), so one emitter scatters all nine.
#texture FlowerAtlas
mapping = uv;
wrap = clamp;
size = 512;
let q0 = uv * 3.0 - vec2(0.0, 0.0);
let v0 = q0 - vec2(0.5, 0.5);
let cov0 = 0.0;
for i in 0..5 {
  let a = 0.300 + i * 1.25664 + (rand(i * 3.0 + 1.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4400 * (0.93 + 0.09 * rand(i * 7.0 + 2.0));
  let m = fill(sdf.segment(q0, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1500)) - 0.1500 * (0.72 + 0.42 * sat(length(v0) / l)));
  let cov0 = max(cov0, m);
}
let r0 = length(v0) / 0.4400;
let lobe0 = 0.5 + 0.5 * cos(5.0 * (atan2(v0.y, v0.x) - 0.300));
let pc0 = mix(mix(color("#a9c9ff"), color("#5d93ea"), smoothstep(0.12, 0.62, r0)), color("#3f6fd2"), smoothstep(0.7, 1.0, r0) * 0.75);
let pcs0 = pc0 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe0));
let cr0 = fill(sdf.circle(q0, vec2(0.5, 0.5), 0.1000));
let dt0 = fill(sdf.circle(q0, vec2(0.5, 0.5), 0.0450));
let fc0 = mix(mix(pcs0, color("#fff3c4"), cr0), color("#f2c440"), dt0);
let fa0 = max(cov0, cr0);
let q1 = uv * 3.0 - vec2(1.0, 0.0);
let v1 = q1 - vec2(0.5, 0.5);
let cov1 = 0.0;
for i in 0..5 {
  let a = 1.100 + i * 1.25664 + (rand(i * 3.0 + 18.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4048 * (0.93 + 0.09 * rand(i * 7.0 + 19.0));
  let m = fill(sdf.segment(q1, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1380)) - 0.1380 * (0.72 + 0.42 * sat(length(v1) / l)));
  let cov1 = max(cov1, m);
}
let r1 = length(v1) / 0.4048;
let lobe1 = 0.5 + 0.5 * cos(5.0 * (atan2(v1.y, v1.x) - 1.100));
let pc1 = mix(mix(color("#d4ecff"), color("#92cbf6"), smoothstep(0.12, 0.62, r1)), color("#5ea6ea"), smoothstep(0.7, 1.0, r1) * 0.75);
let pcs1 = pc1 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe1));
let cr1 = fill(sdf.circle(q1, vec2(0.5, 0.5), 0.0920));
let dt1 = fill(sdf.circle(q1, vec2(0.5, 0.5), 0.0414));
let fc1 = mix(mix(pcs1, color("#ffffff"), cr1), color("#f3d35a"), dt1);
let fa1 = max(cov1, cr1);
let q2 = uv * 3.0 - vec2(2.0, 0.0);
let v2 = q2 - vec2(0.5, 0.5);
let cov2 = 0.0;
for i in 0..5 {
  let a = 0.700 + i * 1.25664 + (rand(i * 3.0 + 35.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4224 * (0.93 + 0.09 * rand(i * 7.0 + 36.0));
  let m = fill(sdf.segment(q2, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1440)) - 0.1440 * (0.72 + 0.42 * sat(length(v2) / l)));
  let cov2 = max(cov2, m);
}
let r2 = length(v2) / 0.4224;
let lobe2 = 0.5 + 0.5 * cos(5.0 * (atan2(v2.y, v2.x) - 0.700));
let pc2 = mix(mix(color("#c5b4ff"), color("#8d70e2"), smoothstep(0.12, 0.62, r2)), color("#6a4fca"), smoothstep(0.7, 1.0, r2) * 0.75);
let pcs2 = pc2 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe2));
let cr2 = fill(sdf.circle(q2, vec2(0.5, 0.5), 0.0960));
let dt2 = fill(sdf.circle(q2, vec2(0.5, 0.5), 0.0432));
let fc2 = mix(mix(pcs2, color("#f6efff"), cr2), color("#f5d060"), dt2);
let fa2 = max(cov2, cr2);
let q3 = uv * 3.0 - vec2(0.0, 1.0);
let v3 = q3 - vec2(0.5, 0.5);
let cov3 = 0.0;
for i in 0..6 {
  let a = 0.200 + i * 1.04720 + (rand(i * 3.0 + 52.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.3784 * (0.93 + 0.09 * rand(i * 7.0 + 53.0));
  let m = fill(sdf.segment(q3, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1144)) - 0.1144 * (0.72 + 0.42 * sat(length(v3) / l)));
  let cov3 = max(cov3, m);
}
let r3 = length(v3) / 0.3784;
let lobe3 = 0.5 + 0.5 * cos(6.0 * (atan2(v3.y, v3.x) - 0.200));
let pc3 = mix(mix(color("#e2d8ff"), color("#b9a4f3"), smoothstep(0.12, 0.62, r3)), color("#9580e0"), smoothstep(0.7, 1.0, r3) * 0.75);
let pcs3 = pc3 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe3));
let cr3 = fill(sdf.circle(q3, vec2(0.5, 0.5), 0.0880));
let dt3 = fill(sdf.circle(q3, vec2(0.5, 0.5), 0.0396));
let fc3 = mix(mix(pcs3, color("#fff5d6"), cr3), color("#f0c048"), dt3);
let fa3 = max(cov3, cr3);
let q4 = uv * 3.0 - vec2(1.0, 1.0);
let v4 = q4 - vec2(0.5, 0.5);
let cov4 = 0.0;
for i in 0..9 {
  let a = 0.100 + i * 0.69813 + (rand(i * 3.0 + 69.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4500 * (0.93 + 0.09 * rand(i * 7.0 + 70.0));
  let m = fill(sdf.segment(q4, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.0750)) - 0.0750 * (0.72 + 0.42 * sat(length(v4) / l)));
  let cov4 = max(cov4, m);
}
let r4 = length(v4) / 0.4500;
let lobe4 = 0.5 + 0.5 * cos(9.0 * (atan2(v4.y, v4.x) - 0.100));
let pc4 = mix(mix(color("#fff0a0"), color("#f7d24c"), smoothstep(0.12, 0.62, r4)), color("#eaa62a"), smoothstep(0.7, 1.0, r4) * 0.75);
let pcs4 = pc4 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe4));
let cr4 = fill(sdf.circle(q4, vec2(0.5, 0.5), 0.1300));
let dt4 = fill(sdf.circle(q4, vec2(0.5, 0.5), 0.0585));
let fc4 = mix(mix(pcs4, color("#f39ab0"), cr4), color("#e8668a"), dt4);
let fa4 = max(cov4, cr4);
let q5 = uv * 3.0 - vec2(2.0, 1.0);
let v5 = q5 - vec2(0.5, 0.5);
let cov5 = 0.0;
for i in 0..5 {
  let a = 0.900 + i * 1.25664 + (rand(i * 3.0 + 86.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4500 * (0.93 + 0.09 * rand(i * 7.0 + 87.0));
  let m = fill(sdf.segment(q5, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1550)) - 0.1550 * (0.72 + 0.42 * sat(length(v5) / l)));
  let cov5 = max(cov5, m);
}
let r5 = length(v5) / 0.4500;
let lobe5 = 0.5 + 0.5 * cos(5.0 * (atan2(v5.y, v5.x) - 0.900));
let pc5 = mix(mix(color("#bfe0ff"), color("#6cb3f2"), smoothstep(0.12, 0.62, r5)), color("#4a8ee0"), smoothstep(0.7, 1.0, r5) * 0.75);
let pcs5 = pc5 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe5));
let cr5 = fill(sdf.circle(q5, vec2(0.5, 0.5), 0.1000));
let dt5 = fill(sdf.circle(q5, vec2(0.5, 0.5), 0.0450));
let fc5 = mix(mix(pcs5, color("#fffbe0"), cr5), color("#f5c542"), dt5);
let fa5 = max(cov5, cr5);
let q6 = uv * 3.0 - vec2(0.0, 2.0);
let v6 = q6 - vec2(0.5, 0.5);
let cov6 = 0.0;
for i in 0..5 {
  let a = 0.500 + i * 1.25664 + (rand(i * 3.0 + 103.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.3528 * (0.93 + 0.09 * rand(i * 7.0 + 104.0));
  let m = fill(sdf.segment(q6, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.1218)) - 0.1218 * (0.72 + 0.42 * sat(length(v6) / l)));
  let cov6 = max(cov6, m);
}
let r6 = length(v6) / 0.3528;
let lobe6 = 0.5 + 0.5 * cos(5.0 * (atan2(v6.y, v6.x) - 0.500));
let pc6 = mix(mix(color("#a993f0"), color("#7658d0"), smoothstep(0.12, 0.62, r6)), color("#5a3cb4"), smoothstep(0.7, 1.0, r6) * 0.75);
let pcs6 = pc6 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe6));
let cr6 = fill(sdf.circle(q6, vec2(0.5, 0.5), 0.0840));
let dt6 = fill(sdf.circle(q6, vec2(0.5, 0.5), 0.0378));
let fc6 = mix(mix(pcs6, color("#ffffff"), cr6), color("#f7d66a"), dt6);
let fa6 = max(cov6, cr6);
let q7 = uv * 3.0 - vec2(1.0, 2.0);
let v7 = q7 - vec2(0.5, 0.5);
let cov7 = 0.0;
for i in 0..6 {
  let a = 0.000 + i * 1.04720 + (rand(i * 3.0 + 120.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.3200 * (0.93 + 0.09 * rand(i * 7.0 + 121.0));
  let m = fill(sdf.segment(q7, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.0960)) - 0.0960 * (0.72 + 0.42 * sat(length(v7) / l)));
  let cov7 = max(cov7, m);
}
let r7 = length(v7) / 0.3200;
let lobe7 = 0.5 + 0.5 * cos(6.0 * (atan2(v7.y, v7.x) - 0.000));
let pc7 = mix(mix(color("#ffffff"), color("#f8f6ff"), smoothstep(0.12, 0.62, r7)), color("#d4d8f2"), smoothstep(0.7, 1.0, r7) * 0.75);
let pcs7 = pc7 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe7));
let cr7 = fill(sdf.circle(q7, vec2(0.5, 0.5), 0.0880));
let dt7 = fill(sdf.circle(q7, vec2(0.5, 0.5), 0.0396));
let fc7 = mix(mix(pcs7, color("#f6cf3a"), cr7), color("#eeac2c"), dt7);
let fa7 = max(cov7, cr7);
let q8 = uv * 3.0 - vec2(2.0, 2.0);
let v8 = q8 - vec2(0.5, 0.5);
let cov8 = 0.0;
for i in 0..8 {
  let a = 0.400 + i * 0.78540 + (rand(i * 3.0 + 137.0) - 0.5) * 0.16;
  let dir = vec2(cos(a), sin(a));
  let l = 0.4136 * (0.93 + 0.09 * rand(i * 7.0 + 138.0));
  let m = fill(sdf.segment(q8, vec2(0.5, 0.5) + dir * 0.04, vec2(0.5, 0.5) + dir * (l - 0.0940)) - 0.0940 * (0.72 + 0.42 * sat(length(v8) / l)));
  let cov8 = max(cov8, m);
}
let r8 = length(v8) / 0.4136;
let lobe8 = 0.5 + 0.5 * cos(8.0 * (atan2(v8.y, v8.x) - 0.400));
let pc8 = mix(mix(color("#fff2b0"), color("#f9d85c"), smoothstep(0.12, 0.62, r8)), color("#efb23a"), smoothstep(0.7, 1.0, r8) * 0.75);
let pcs8 = pc8 * (0.84 + 0.16 * smoothstep(0.0, 0.35, lobe8));
let cr8 = fill(sdf.circle(q8, vec2(0.5, 0.5), 0.1128));
let dt8 = fill(sdf.circle(q8, vec2(0.5, 0.5), 0.0508));
let fc8 = mix(mix(pcs8, color("#ffa184"), cr8), color("#f0785a"), dt8);
let fa8 = max(cov8, cr8);
let sum_c = fc0 * fa0 + fc1 * fa1 + fc2 * fa2 + fc3 * fa3 + fc4 * fa4 + fc5 * fa5 + fc6 * fa6 + fc7 * fa7 + fc8 * fa8;
let sum_a = fa0 + fa1 + fa2 + fa3 + fa4 + fa5 + fa6 + fa7 + fa8;
out.color = sum_c / max(sum_a, 0.001);
out.alpha = sat(sum_a);
#end

#texture PetalAtlas
mapping = uv;
wrap = clamp;
size = 128;
let q = fract(uv * 2.0);
let id = floor(uv.x * 2.0) + 2.0 * floor(uv.y * 2.0);
let d = sdf.segment(q, vec2(0.5, 0.22), vec2(0.5, 0.7)) - 0.2 * (0.55 + 0.45 * sat((q.y - 0.15) / 0.6));
let c0 = color("#f6f2ff");
let c1 = color("#aad3fb");
let c2 = color("#b9a0f2");
let c3 = color("#fbe590");
let col = mix(mix(c0, c1, step(0.5, id)), mix(c2, c3, step(2.5, id)), step(1.5, id));
out.color = mix(col, color("#ffffff"), sat(0.45 - q.y * 0.5));
out.alpha = fill(d);
#end

// Mint-white casting circle from the reel: double outer ring with rune glyphs, dashed middle ring, flower-of-life core.
#texture RuneCircle
mapping = uv;
wrap = clamp;
size = 512;
let c = vec2(0.5, 0.5);
let p = uv - c;
let r = length(p);
let ang = atan2(p.y, p.x) / 6.2832 + 0.5;
let rings = max(max(stroke(sdf.circle(uv, c, 0.478), 0.009), stroke(sdf.circle(uv, c, 0.398), 0.006)), max(stroke(sdf.circle(uv, c, 0.30), 0.005), stroke(sdf.circle(uv, c, 0.115), 0.005)));
let dash = stroke(sdf.circle(uv, c, 0.348), 0.0035) * step(0.45, fract(ang * 60.0));
let cf = ang * 26.0;
let cell = floor(cf);
let fx = fract(cf);
let fy = (r - 0.408) / 0.06;
let inband = step(0.0, fy) * step(fy, 1.0) * step(0.14, fx) * step(fx, 0.86);
let bar = step(abs(fx - 0.5), 0.06) * step(0.12, fy) * step(fy, 0.88) * step(0.25, rand(cell * 1.3 + 4.0));
let h1 = step(abs(fy - 0.28), 0.07) * step(abs(fx - 0.5), 0.3) * step(0.45, rand(cell * 3.1 + 1.0));
let h2 = step(abs(fy - 0.72), 0.07) * step(abs(fx - 0.5), 0.3) * step(0.5, rand(cell * 5.3 + 2.0));
let dg = step(abs((fx - 0.5) - (fy - 0.5) * 0.7), 0.06) * step(0.12, fy) * step(fy, 0.88) * step(0.55, rand(cell * 7.7 + 3.0));
let glyph = max(max(bar, h1), max(h2, dg)) * inband;
let fl = 0.0;
for k in 0..6 {
  let fl = max(fl, stroke(sdf.circle(uv, c + vec2(cos(k * 1.0472 + 0.5236), sin(k * 1.0472 + 0.5236)) * 0.15, 0.15), 0.0045));
}
let dots = 0.0;
for k in 0..12 {
  let dots = max(dots, fill(sdf.circle(uv, c + vec2(cos(k * 0.5236), sin(k * 0.5236)) * 0.325, 0.009)));
}
let lines = max(max(rings, dash), max(glyph, max(fl * step(r, 0.305), dots)));
let halo = smoothstep(0.5, 0.0, r) * 0.16 + smoothstep(0.03, 0.0, abs(r - 0.44)) * 0.22;
let m = sat(lines + halo * step(r, 0.5));
out.color = mix(vec3(0.62, 1.0, 0.78), vec3(1.0, 1.0, 1.0), sat(lines));
out.alpha = m;
#end

#texture RingGlow
mapping = uv;
wrap = clamp;
size = 256;
let d = abs(length(uv - vec2(0.5, 0.5)) - 0.45);
out.color = vec3(1.0, 1.0, 1.0);
out.alpha = smoothstep(0.05, 0.0, d) * 0.7 + smoothstep(0.012, 0.0, d) * 0.3;
#end

#texture GlowDot
mapping = uv;
wrap = clamp;
size = 64;
let d = length(uv - vec2(0.5, 0.5));
out.color = vec3(1.0, 1.0, 1.0) * smoothstep(0.5, 0.0, d);
out.alpha = smoothstep(0.5, 0.05, d);
#end

