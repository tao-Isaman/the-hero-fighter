// ---------- step 3: flower spell ----------
// Nine flower textures grown from the daisy sketch (reference image 3): same rounded-petal brush shape, varied petal count, width and colour.
#texture Flower1
mapping = uv;
wrap = clamp;
render_mode = cutout_twosided;
size = 128;
param petals = 8.0;
param plen = 0.44;
param pwid = 0.085;
param rot = 0.3;
param crad = 0.12;
param base_col = color("#f7f4ea");
param edge_col = color("#d5dfee");
param core_col = color("#f6cf27");
let c = vec2(0.5, 0.5);
let cov = 0.0;
let pid = 0.0;
for k in 0..12 {
  let on = step(k + 0.5, petals);
  let a = rot + k * 6.2832 / petals + (rand(k * 3.0 + 1.0) - 0.5) * 0.2;
  let l = plen * (0.88 + 0.14 * rand(k * 7.0 + 2.0));
  let dir = vec2(cos(a), sin(a));
  let w = pwid * (0.9 + 0.25 * rand(k * 5.0 + 9.0));
  let m = fill(sdf.segment(uv, c + dir * 0.06, c + dir * (l - w)) - w * (0.75 + 0.45 * sat(length(uv - c) / l))) * on;
  let pid = select(pid, rand(k * 11.0 + 5.0), m);
  let cov = max(cov, m);
}
let r = length(uv - c) / plen;
let streak = noise.fbm(vec2(atan2(uv.y - 0.5, uv.x - 0.5) * 9.0, r * 2.0), octaves: 2, seed: 4);
let petal_col = mix(base_col, edge_col, sat(0.65 - r * 0.6 + 0.4 * streak)) * (0.93 + 0.1 * pid);
let core = fill(sdf.circle(uv, c, crad + 0.012 * noise.fbm(uv * 30.0, octaves: 2, seed: 9)));
let dots = noise.fbm(uv * 60.0, octaves: 1, seed: 2);
let core_shade = mix(core_col * 0.8, core_col * 1.05, sat(1.0 - length(uv - c - vec2(-0.03, -0.03)) / crad + 0.25 * dots));
out.color = mix(petal_col, core_shade, core);
out.alpha = max(cov, core);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

