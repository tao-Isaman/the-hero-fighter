#end

#mesh Gazebo
let base = box_at(size: (190, 190, 30), bottom_center: (0, 0, 0), bevel: 4, material: "StoneLight");
let posts = grid_array(box_at(size: (13, 13, 170), bottom_center: (-75, -75, 30), bevel: 2, material: "WoodWarm"), count: (2, 2, 1), offset: (150, 150, 0));
let beamsX = array(box_at(size: (172, 12, 12), bottom_center: (0, -75, 196), bevel: 2, material: "WoodShade"), count: 2, offset: (0, 150, 0));
let beamsY = array(box_at(size: (12, 172, 12), bottom_center: (-75, 0, 196), bevel: 2, material: "WoodShade"), count: 2, offset: (150, 0, 0));
let roof = rotate_z(cylinder_at(r_bot: 140, r_top: 6, height: 140, segments: 4, bottom_center: (0, 0, 210), material: "RoofOrange"), 45, pivot: (0, 0, 0));
let eave = rotate_z(cylinder_at(r_bot: 145, r_top: 140, height: 8, segments: 4, bottom_center: (0, 0, 204), material: "WoodShade"), 45, pivot: (0, 0, 0));
let finial = sphere_center(radius: 9, center: (0, 0, 353), material: "WoodShade");
let wellRing = cylinder_at(radius: 42, height: 60, segments: 16, bottom_center: (0, 0, 30), material: "StoneLight");
let water = cylinder_at(radius: 35, height: 2, segments: 16, bottom_center: (0, 0, 88), material: "WaterDark");
out.geo = merge(base, posts, beamsX, beamsY, roof, eave, finial, wellRing, water);
#end

#mesh MarketCart
let body = box_at(size: (150, 110, 60), bottom_center: (0, 0, 50), bevel: 3, material: "WoodWarm");
let trim = box_at(size: (156, 116, 8), bottom_center: (0, 0, 106), bevel: 2, material: "WoodShade");
let rim = rotate_x(torus(major_radius: 40, tube_radius: 6, segments: 20, tube_segments: 8, material: "WoodShade"), 90);
let spoke = cylinder_between(start: (0, 0, -37), end: (0, 0, 37), radius: 2.5, segments: 6, material: "WoodShade");
let spokes = merge(spoke, rotate_y(spoke, 45), rotate_y(spoke, 90), rotate_y(spoke, 135));
let hub = rotate_x(cylinder_center(radius: 8, height: 14, segments: 10, center: (0, 0, 0), material: "IronDark"), 90);
let wheel = merge(rim, spokes, hub);
let wheels = merge(translate(wheel, (20, -64, 46)), translate(wheel, (20, 64, 46)));
let postBack = box_at(size: (6, 6, 110), bottom_center: (70, -52, 110), material: "WoodShade");
let postFront = box_at(size: (6, 6, 80), bottom_center: (-70, -52, 110), material: "WoodShade");
let posts = merge(postBack, translate(postBack, (0, 104, 0)), postFront, translate(postFront, (0, 104, 0)));
let s0 = rotate_y(box_center(size: (190, 20, 3), center: (0, -60, 0), material: "FabricBlue"), -10);
let s1 = rotate_y(box_center(size: (190, 20, 3), center: (0, -40, 0), material: "FabricWhite"), -10);
let s2 = rotate_y(box_center(size: (190, 20, 3), center: (0, -20, 0), material: "FabricBlue"), -10);
let s3 = rotate_y(box_center(size: (190, 20, 3), center: (0, 0, 0), material: "FabricWhite"), -10);
let s4 = rotate_y(box_center(size: (190, 20, 3), center: (0, 20, 0), material: "FabricBlue"), -10);
let s5 = rotate_y(box_center(size: (190, 20, 3), center: (0, 40, 0), material: "FabricWhite"), -10);
let s6 = rotate_y(box_center(size: (190, 20, 3), center: (0, 60, 0), material: "FabricBlue"), -10);
let awning = translate(merge(s0, s1, s2, s3, s4, s5, s6), (0, 0, 205));
let flapB = box_center(size: (3, 20, 22), center: (-94, -60, 178), material: "FabricBlue");
let flapW = box_center(size: (3, 20, 22), center: (-94, -40, 178), material: "FabricWhite");
let flaps = merge(array(flapB, count: 4, offset: (0, 40, 0)), array(flapW, count: 3, offset: (0, 40, 0)));
let goods = merge(
    box_at(size: (40, 34, 26), bottom_center: (30, -20, 114), bevel: 2, material: "WoodWarm"),
    sphere_center(radius: 16, center: (-30, 22, 126), material: "FabricWhite"),
    sphere_center(radius: 14, center: (-10, -28, 124), material: "RoofOrange")
);
let shafts = merge(
    cylinder_between(start: (-75, -40, 70), end: (-200, -55, 4), radius: 4, segments: 8, material: "WoodShade"),
    cylinder_between(start: (-75, 40, 70), end: (-200, 55, 4), radius: 4, segments: 8, material: "WoodShade")
);
out.geo = merge(body, trim, wheels, posts, awning, flaps, goods, shafts);
#end

