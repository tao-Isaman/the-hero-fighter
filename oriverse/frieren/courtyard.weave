// ---------- props ----------
#mesh Bench
let seat = merge(
    box_at(size: (16, 170, 5), bottom_center: (-14, 0, 42), bevel: 1.5, material: "WoodWarm"),
    box_at(size: (16, 170, 5), bottom_center: (4, 0, 42), bevel: 1.5, material: "WoodWarm"),
    box_at(size: (14, 170, 5), bottom_center: (21, 0, 42), bevel: 1.5, material: "WoodWarm")
);
let back = merge(
    box_at(size: (5, 170, 13), bottom_center: (30, 0, 58), bevel: 1.5, material: "WoodWarm"),
    box_at(size: (5, 170, 13), bottom_center: (32, 0, 75), bevel: 1.5, material: "WoodWarm")
);
let legL = merge(
    box_at(size: (8, 8, 42), bottom_center: (-16, -70, 0), bevel: 1, material: "WoodShade"),
    box_at(size: (8, 8, 90), bottom_center: (30, -70, 0), bevel: 1, material: "WoodShade"),
    box_at(size: (52, 7, 6), bottom_center: (7, -70, 36), bevel: 1, material: "WoodShade")
);
let legR = translate(legL, (0, 140, 0));
out.geo = merge(seat, back, legL, legR);
#end

#mesh Crate
let core = box_at(size: (56, 56, 56), bottom_center: (0, 0, 2), bevel: 1, material: "WoodWarm");
let posts = grid_array(box_at(size: (8, 8, 60), bottom_center: (-26, -26, 0), bevel: 1, material: "WoodShade"), count: (2, 2, 1), offset: (52, 52, 0));
let railsX = grid_array(box_at(size: (60, 8, 8), bottom_center: (0, -26, 0), bevel: 1, material: "WoodShade"), count: (1, 2, 2), offset: (0, 52, 52));
let railsY = grid_array(box_at(size: (8, 60, 8), bottom_center: (-26, 0, 0), bevel: 1, material: "WoodShade"), count: (2, 1, 2), offset: (52, 0, 52));
out.geo = merge(core, posts, railsX, railsY);
#end

#mesh FenceBroken
let p1 = box_at(size: (10, 10, 80), bottom_center: (0, -65, 0), bevel: 1.5, material: "WoodShade");
let p2 = rotate_x(box_at(size: (10, 10, 70), bottom_center: (0, 65, 0), bevel: 1.5, material: "WoodShade"), 12, pivot: (0, 65, 0));
let r1 = box_at(size: (5, 150, 12), bottom_center: (-4, 0, 55), bevel: 1.5, material: "WoodWarm");
let r2 = rotate_x(box_at(size: (5, 150, 12), bottom_center: (-6, 0, 22), bevel: 1.5, material: "WoodWarm"), -8, pivot: (0, 0, 28));
out.geo = merge(p1, p2, r1, r2);
#end

#mesh SignPost
let post = box_at(size: (12, 12, 105), bottom_center: (0, 0, 0), bevel: 2, material: "WoodWarm");
