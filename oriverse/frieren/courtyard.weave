#artstyle "stylized hand-painted fantasy MMO village, saturated warm greens, soft painterly shading, chunky cartoon proportions"

// ---------- camera: matches reference image 1 (high 3/4 view, 45 deg down) ----------
#class player
event OnSpawned {
    SetPlayerModeSpectator()
    SetCameraFixed(Position(0, 0, 950), Position(950, 0, 0), 45)
}
#end

// ---------- look knobs ----------
#adjuster
section "Grass"
knob SetGrassRootColor = #2f6b16
knob SetGrassTipColor = #a8d84a
knob SetGrassBrightnessVariationPercent = 120
knob SetGrassSizeVariationPercent = 100
knob SetGrassHeightMinCm = 22
knob SetGrassHeightMaxCm = 55
knob SetGrassWavePeriodCm = 450
knob SetGrassWindStrengthCm = 5
knob SetGrassBladeWidthPercent = 150
section "Light"
knob SetSunRotation = 250
knob SetSunTilt = 38
knob SetSunIntensity = 7
knob SetSunColor = #ffe2b0
knob SetSkyLightIntensity = 1.7
knob SetSkyLightColor = #d6ecff
knob SetShadowLift = 0.6
knob SetShadowDistance = 60
knob SetShadowBlurRadius = 2.5
knob SetSkyboxCloudCoverage = 0.25
knob SetSkyboxHaze = 0.6
knob SetFogStartDistance = 60
knob SetFogEndDistance = 600
#end

// ---------- materials ----------
material WoodWarm { base = "WoodDetail" tint = "#a8763f" }
material WoodShade { base = "WoodDetail" tint = "#6a4428" }
material DoorWood { base = "WoodDetail" tint = "#5a3a22" }
material StoneLight { base = "StoneDetail" tint = "#d9d2c2" }
material StoneDark { base = "StoneDetail" tint = "#9c968a" }
material MossStone { base = "StoneDetail" tint = "#a7a99a" }
material PlasterCream { base = "PlasterDetail" tint = "#f0e3c6" }
material RoofOrange { base = "WoodDetail" tint = "#d4733a" }
material RoofSlate { base = "StoneDetail" tint = "#5d6b80" }
material FabricWhite { base = "FabricDetail" tint = "#f4f3ee" }
material FabricBlue { base = "FabricDetail" tint = "#3f7fcf" }
material IronDark { base = "MetalDetail" tint = "#3b3b3b" roughness = 0.7 }
material BarkWarm { base = "Bark" tint = "#7d5638" }
#texture GlassBlue color=#3c5872 roughness=0.3
#texture WaterDark color=#2b4655 roughness=0.15
#texture PetalWhite color=#fbfbf2 roughness=0.8
#texture PetalYellow color=#ffd83a roughness=0.8
#texture PetalHeart color=#f2a922 roughness=0.8
#texture StemGreen color=#4f8f2a roughness=0.9

// ---------- ground ----------
#texture GrassGround
tile_m = 3.0;
let n = noise.fbm(uv * 6.0, octaves: 4, seed: 7, period: 6);
let m = noise.fbm(uv * 24.0, octaves: 2, seed: 9, period: 24);
out.color = mix(color("#4f8f2a"), color("#7fbf3c"), n) * (0.94 + m * 0.1);
out.height = n * 0.5 + m * 0.5;
out.normal = normal_from_height(n * 0.4 + m * 0.6, strength: 0.4);
out.orm = orm(occlusion: 1.0, roughness: 0.95, metallic: 0.0);
#end

#texture DirtGround
tile_m = 4.0;
let n = noise.fbm(uv * 6.0, octaves: 4, seed: 3, period: 6);
let s = noise.fbm(uv * 24.0, octaves: 2, seed: 11, period: 24);
out.color = mix(color("#c99f5a"), color("#e8c784"), n) * (0.95 + s * 0.08);
out.height = n * 0.6 + s * 0.4;
out.normal = normal_from_height(n * 0.6 + s * 0.4, strength: 0.15);
out.orm = orm(occlusion: 1.0, roughness: 0.95, metallic: 0.0);
#end

#terrain_surfaces CourtSurfaces
surface = baked.GrassGround.color, baked.GrassGround.normal, 3.0, baked.GrassGround.orm, 1.0
surface = baked.DirtGround.color, baked.DirtGround.normal, 4.0, baked.DirtGround.orm, 0.0
#end

// Dirt patches: colour-segmented from the reference, contours back-projected to ground meters
#terrain_paint CourtyardPaint
surfaces = CourtSurfaces
palette = [meadow, dirt]
base = surface=meadow,density=1,height=1
polygon D0 = outer=[(4.8,4.4),(5.2,5.1),(5.3,5.4),(4.8,5.9),(4.4,6.8),(2.9,6.3),(2.9,4.0),(4.4,4.5),(4.6,4.4)]
polygon D1 = outer=[(6.4,2.9),(6.1,2.7),(5.5,1.7),(5.5,0.6),(5.8,0.1),(6.0,0.2),(6.1,0.6),(6.5,1.7),(6.9,1.9),(7.0,2.2),(6.8,2.8)]
polygon D2 = outer=[(9.7,6.5),(10.3,7.5),(10.0,7.7),(10.2,8.0),(9.9,8.2),(9.2,8.2),(9.1,8.7),(8.8,8.7),(8.0,8.2),(7.4,7.9),(7.1,7.0),(7.3,6.5),(8.6,6.3),(9.0,6.5),(9.4,6.4)]
polygon D3 = outer=[(7.9,0.9),(7.5,0.7),(7.1,0.3),(6.9,-1.1),(6.5,-2.6),(6.2,-3.0),(4.9,-3.7),(4.5,-4.3),(4.2,-4.6),(4.1,-4.9),(2.9,-4.5),(2.9,-7.6),(4.9,-8.8),(5.0,-7.3),(5.2,-7.4),(5.9,-7.1),(6.5,-6.8),(7.1,-5.9),(8.5,-5.2),(9.0,-4.4),(9.3,-4.3),(9.3,-3.7),(9.8,-3.7),(10.3,-3.1),(10.6,-3.0),(10.9,-3.2),(10.8,-3.8),(10.9,-4.0),(11.7,-4.2),(12.0,-4.3),(12.5,-4.1),(12.9,-3.1),(13.3,-2.8),(13.4,-2.2),(13.3,-1.9),(12.6,-1.7),(11.6,-1.0),(11.0,-0.9),(10.2,-0.4),(9.6,-0.4),(9.2,-0.1),(8.8,-0.1)]
polygon D4 = outer=[(12.4,7.0),(13.2,7.7),(13.5,8.2),(13.3,8.2),(12.6,8.0),(12.6,9.9),(12.9,10.1),(12.8,10.4),(12.3,10.6),(10.7,9.7),(10.6,10.1),(10.2,10.0),(9.8,9.6),(10.2,9.5),(10.1,9.0),(11.0,8.9),(10.6,8.1),(10.5,7.5),(11.0,7.3),(11.7,6.8)]
polygon D5 = outer=[(13.8,6.5),(13.4,6.3),(12.2,4.7),(12.1,3.4),(12.4,3.1),(13.1,3.0),(13.6,3.1),(13.9,4.5),(14.5,5.2),(14.5,6.2)]
union Dirt = fields=[D0,D1,D2,D3,D4,D5]
layer DirtLayer = field=Dirt,surface=dirt,fade=0.35,density_fade=0.3,height_fade=0.5,density=0,height=0
#end

#terrain Ground
mound_height_m = 0
gully_depth_m = 0
detail Bumps = height=0.2, size=9
channel Drop = outer=[(20,-8),(90,-8),(90,-90),(20,-90)], level=0, depth=30, bank=4, bed_fade=6
#end

#class WorldSetup
event OnSpawned {
    var terrain = SpawnTerrainRecipe(100, Position(0, 0, 0))
    terrain.SetTerrainPaint("CourtyardPaint")
    SetSaturation(1.1)
    SetWaterEnabled(true)
    SetWaterSeaLevelCm(-2200)
    SetContrast(1.08)
    SetBloomIntensity(0.2)
    SetVolumetricLightIntensity(35)
    SetWind(30, 0.25, 0.4)
    SetSsrOff()
}
#end
display WorldSetupObj : WorldSetup { visible = false }

// ---------- foliage ----------
#texture LeafClump
mapping = uv;
wrap = clamp;
render_mode = cutout;
size = 512;
let cov = 0.0;
let tone = 0.0;
for i in 0..14 {
  let a = i * 2.39996;
  let r = 0.03 + 0.35 * sqrt((i + 0.5) / 14.0);
  let c = vec2(0.5 + r * cos(a), 0.56 + r * 0.82 * sin(a));
  let s = 0.13 + 0.05 * rand(i * 13.0 + 1.0);
  let rot = 1.2 + rand(i * 7.0 + 3.0) * 1.4;
  let d0 = vec2(cos(rot), sin(rot));
  let d1 = vec2(cos(rot + 1.2566), sin(rot + 1.2566));
  let d2 = vec2(cos(rot + 2.5133), sin(rot + 2.5133));
  let d3 = vec2(cos(rot + 3.7699), sin(rot + 3.7699));
  let d4 = vec2(cos(rot + 5.0265), sin(rot + 5.0265));
  let l0 = fill(sdf.leaf(uv, base: c, tip: c + d0 * s, width: s * 0.55));
  let l1 = fill(sdf.leaf(uv, base: c, tip: c + d1 * s * 0.85, width: s * 0.48));
  let l2 = fill(sdf.leaf(uv, base: c, tip: c + d2 * s * 0.5, width: s * 0.34));
  let l3 = fill(sdf.leaf(uv, base: c, tip: c + d3 * s * 0.5, width: s * 0.34));
  let l4 = fill(sdf.leaf(uv, base: c, tip: c + d4 * s * 0.85, width: s * 0.48));
  let hub = fill(sdf.circle(uv, c, s * 0.28));
  let leaf = max(max(max(l0, l1), max(l2, l3)), max(l4, hub));
  let cov = max(cov, leaf);
  let tone = select(tone, rand(i * 5.0 + 11.0), leaf);
}
let grain = noise.fbm(uv * 40.0, octaves: 2, seed: 3);
out.color = mix(color("#2f6a1c"), color("#a9db52"), sat(0.15 + 0.75 * tone + 0.1 * grain));
out.alpha = cov;
out.orm = orm(occlusion: 1.0, roughness: 0.8, metallic: 0.0);
#end

