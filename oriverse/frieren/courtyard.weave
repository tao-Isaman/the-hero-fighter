// Spell timeline. Phase 1 (cast): circle, light tube, levitation. Phase 2: flower rings bloom outward and pulse.
// Phase 3: each ring bursts into petals that drift up and fade. Repeats every CycleFrames; F casts immediately.
#class FlowerSpell
var T = 0
var Base: Position
var CastAt = 90
const CycleFrames = 960
event OnSpawned {
    Base = GetPosition()
    forever {
        T = T + 1
        if T == CastAt {
            SpawnEffectWithAutoDestroy(Ori.effect.CastCircle, Position(Base.X, Base.Y, Base.Z + 3))
            SpawnEffectWithAutoDestroy(Ori.effect.CastLight, Position(Base.X, Base.Y, Base.Z + 200))
        }
        if T == CastAt + 100 {
            SpawnEffectWithAutoDestroy(Ori.effect.FlowerWave, Position(Base.X, Base.Y, Base.Z + 30))
            SpawnEffectWithAutoDestroy(Ori.effect.PetalRise, Position(Base.X, Base.Y, Base.Z + 150))
        }
        var lift = 0
        if T > CastAt and T < CastAt + 520 {
            var ramp = (T - CastAt) / 40
            if ramp > 1 { ramp = 1 }
            var fall = (CastAt + 520 - T) / 40
            if fall < ramp { ramp = fall }
            lift = ramp * (22 + 8 * (T * 4).SinDegree())
        }
        if Scene.Mage.Exists() { Scene.Mage.SetPosition(Position(Base.X, Base.Y, Base.Z + lift)) }
        if T >= CycleFrames { T = 0 }
    }
}
event KeyboardDown[F] {
    if T > CastAt + 520 or T < CastAt { T = CastAt - 1 }
}
#end
display SpellCenter : FlowerSpell { visible = false position = (1180, -80, 0) }

// ---------- step 2: the caster (Oriverse-generated sprite from the supplied character sheet) ----------
#sprite ElfMage
source="Ori.sprite.@taoisaman.elf_mage#1"
#end
display Mage { sprite = "ElfMage" size = (1, 190, 190) position = (1180, -80, 0) }
